# Copie este arquivo para config/.env e preencha os valores:
#   cp config/.env.example config/.env

# ----- OpenWeatherMap -----
# Chave gratuita em: https://home.openweathermap.org/api_keys
API_KEY=sua_chave_aqui

# ----- Banco de dados do pipeline (serviço "warehouse") -----
# O container do Postgres é criado com estes valores na primeira subida.
DB_NAME=weather
DB_USER=weather
DB_PASSWORD=troque_esta_senha

# Nome do serviço no docker-compose. Não altere ao rodar via Docker.
DB_HOST=warehouse
DB_PORT=5432
